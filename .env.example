# EduMind FastAPI 环境配置示例
# 复制此文件为 .env 并根据需要修改配置

# ========== 环境配置 ==========
# 可选值: local, development, production
APP_ENV=local

# ========== 应用配置 ==========
APP_NAME=EduMind
DEBUG=true
# 真机/iOS 设备访问时必须监听所有网卡；固定域名部署时若前有 Nginx 反向代理也可维持 127.0.0.1
HOST=0.0.0.0
PORT=2004
SECRET_KEY=your-secret-key-change-in-production
# 登录 token 有效期（秒）与校验时钟偏差（秒），须与 app/utils/auth_token.py 一致
AUTH_TOKEN_TTL_SECONDS=604800
AUTH_TOKEN_CLOCK_SKEW_SECONDS=120
# 开发环境默认账号邮箱（仅在未携带 Authorization / X-User-ID / user_id 时兜底）
DEV_DEFAULT_USER_EMAIL=
# 默认关闭自动建表，避免启动时擅自变更现有 MySQL 表结构；如需初始化请手动运行 scripts/init_db.py
AUTO_CREATE_TABLES=false

# ========== 数据库配置 (MySQL) ==========
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/edumind

# ========== LLM API 配置 (通义千问 / DeepSeek) ==========
# 通义千问 API 密钥 (https://dashscope.console.aliyun.com/)
OPENAI_API_KEY=your-qwen-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
QA_DEFAULT_PROVIDER=qwen
QWEN_QA_MODEL=qwen-plus
DEEPSEEK_QA_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
QA_TOP_K=4
QA_MAX_CONTEXT_CHARS=4500
QA_MAX_HISTORY_MESSAGES=8
QA_MAX_HISTORY_CHARS=2200
AI_UPSTREAM_MAX_CONCURRENCY=8
AI_UPSTREAM_ACQUIRE_TIMEOUT_SECONDS=0.05
AI_NORMAL_TIMEOUT_SECONDS=8
AI_HIGH_TIMEOUT_SECONDS=5
AI_EXTREME_TIMEOUT_SECONDS=3
AI_NORMAL_MAX_TOKENS=1024
AI_HIGH_MAX_TOKENS=256
AI_EXTREME_MAX_TOKENS=96
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=2
AI_CIRCUIT_BREAKER_RECOVERY_SECONDS=20
AI_RESPONSE_CACHE_MAX_ITEMS=256
AI_RESPONSE_CACHE_TTL_SECONDS=300
AI_ADMISSION_ENABLED=true
AI_ADMISSION_MAX_ACTIVE_REQUESTS=80
AI_ADMISSION_MAX_WAITING_REQUESTS=40
AI_ADMISSION_WAIT_TIMEOUT_SECONDS=0.15
AI_ADMISSION_PER_USER_ACTIVE_REQUESTS=6
AI_EVENT_LOOP_LAG_HIGH_SECONDS=0.25
AI_EVENT_LOOP_LAG_EXTREME_SECONDS=0.75
AI_REQUEST_HARD_TIMEOUT_SECONDS=10

# ========== Sleek 设计能力（可选） ==========
# 该能力源自 sleek.design 的 agent-skills 方案，但接入方式是通过 EduMind 后端统一代理，前端与 iOS 容器不直接暴露第三方密钥。
# 先在 https://sleek.design/dashboard/api-keys 创建 API Key，并至少授予 projects:read / projects:write / components:read / chats:read / chats:write / screenshots 所需 scope。
SLEEK_API_KEY=
SLEEK_API_BASE=https://sleek.design
SLEEK_PROJECT_LIMIT=50
SLEEK_POLL_TIMEOUT_SECONDS=300
SLEEK_POLL_INITIAL_INTERVAL_SECONDS=2
SLEEK_POLL_BACKOFF_AFTER_SECONDS=10
SLEEK_POLL_BACKOFF_INTERVAL_SECONDS=5

# ========== 历史 Vinci 微服务接入（可选兼容） ==========
# 实时画面描述已全面切换到 Qwen3-VL；Vinci 路径保留用于重型视频理解（默认禁用）。
VINCI_ENABLED=false
VINCI_BASE_URL=http://127.0.0.1:8010
VINCI_API_KEY=
VINCI_CHAT_PATH=/api/v1/chat
VINCI_STREAM_PATH=/api/v1/chat/stream
VINCI_REQUEST_TIMEOUT_SECONDS=30
VINCI_CONNECT_TIMEOUT_SECONDS=8
VINCI_STREAM_TIMEOUT_SECONDS=120
VINCI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
VINCI_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
# 实时画面描述（本地建议先开，线上按需灰度）
FRAME_DESC_ENABLED=false
FRAME_DESC_BACKEND=qwen3vl
FRAME_DESC_TIMEOUT_SECONDS=8
FRAME_DESC_MAX_FRAME_SIZE=320
# 新配置名；旧 FRAME_DESC_PROBE_VINCI_BEFORE_INFER 仍兼容历史环境
FRAME_DESC_PROBE_UPSTREAM_BEFORE_INFER=false
FRAME_DESC_PROBE_VINCI_BEFORE_INFER=false
FRAME_DESC_PROBE_TIMEOUT_SECONDS=0.5
FRAME_DESC_CONTEXT_WINDOW_SIZE=5
FRAME_DESC_SIMILARITY_THRESHOLD=0.82
FRAME_DESC_SCENE_STABLE_THRESHOLD=4
FRAME_DESC_SKIP_STABLE_SCENE=false
FRAME_DESC_ENABLE_CONTEXT_FUSION=false
FRAME_DESC_DEGRADED_INTERVAL_SECONDS=3
FRAME_DESC_REUSE_RECENT_SECONDS=1.2
FRAME_DESC_MAX_FRAMES_PER_REQUEST=1
FRAME_DESC_AUTO_DEGRADE=true
FRAME_DESC_USE_VINCI_STREAM=false
FRAME_DESC_USE_QWEN3VL_STREAM=false
# 本地联调云端视频时可设为 true；生产默认保持 false，继续要求 video_id 存在于后端库
FRAME_DESC_ALLOW_EXTERNAL_VIDEO=false
# iOS file:// WebView 遇到无 CORS 云端视频时，可让实时描述后端按白名单 URL 抽取单帧。
# 仅本地联调开启；生产默认保持 false，避免开放任意服务端取 URL 能力。
FRAME_DESC_ALLOW_SERVER_FRAME_FETCH=false
FRAME_DESC_SERVER_FRAME_ALLOWED_HOSTS=
FRAME_DESC_SERVER_FRAME_FETCH_TIMEOUT_SECONDS=3
FRAME_DESC_SERVER_FRAME_FETCH_MAX_ATTEMPTS=2
FRAME_DESC_DEBUG_LOG=false
FRAME_DESC_DEBUG_LOG_FILE=logs/frame_description_debug.log
# 本地 Qwen3-VL 不可用时，可启用通义千问视觉 API 作为 Qwen-family 云端补偿层；会发送抽取后的画面帧到云端。
FRAME_DESC_CLOUD_FALLBACK_ENABLED=false
FRAME_DESC_CLOUD_PROVIDER=qwen
FRAME_DESC_CLOUD_QWEN_MODEL=qwen3-vl-plus
FRAME_DESC_CLOUD_QWEN_TIMEOUT_SECONDS=45
FRAME_DESC_CLOUD_QWEN_MAX_TOKENS=256

# Qwen3-VL 实时画面描述服务（推荐：Mac 本地跑模型，后端调用该地址）
QWEN3VL_BASE_URL=http://127.0.0.1:18082
QWEN3VL_HEALTH_PATH=/health
QWEN3VL_DESCRIBE_PATH=/api/v1/video/describe
QWEN3VL_STREAM_PATH=/api/v1/video/describe/stream
QWEN3VL_CONNECT_TIMEOUT_SECONDS=2
QWEN3VL_REQUEST_TIMEOUT_SECONDS=6
QWEN3VL_STREAM_TIMEOUT_SECONDS=9
QWEN3VL_MAX_NEW_TOKENS=48

# ========== Ollama 配置 (仅保留给非问答场景兼容能力) ==========
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=qwen-3.5:9b

# ========== Whisper 配置 (语音识别) ==========
# 可选模型: tiny, base, small, medium, large, turbo (按性能从低到高排序)
# 英语专用模型: tiny.en, base.en, small.en, medium.en
WHISPER_MODEL=base
WHISPER_MODEL_PATH=/var/www/edumind/models/whisper
# 服务启动后是否后台预热默认 Whisper 模型，减少首个转录任务的等待时间
WHISPER_PRELOAD_ON_STARTUP=true
# 模型已存在于本地时使用较短超时，避免加载异常时长时间卡住
WHISPER_LOAD_TIMEOUT_SECONDS=60
# 模型首次下载时允许更长超时，兼容 medium/large 等大模型
WHISPER_DOWNLOAD_TIMEOUT_SECONDS=300
# 独立 Whisper DEBUG 文件日志，仅排查模型加载、设备选择、转录失败时开启
WHISPER_DEBUG_LOG=false
WHISPER_DEBUG_LOG_FILE=logs/whisper_debug.log

# ========== 文件上传目录 ==========
# 不设置时默认为 backend_fastapi/uploads；已上传的视频文件存放在此目录下
# UPLOAD_FOLDER=

# ========== CORS 配置 ==========
# 多个来源用逗号分隔；iOS WKWebView 从本地 file:// 加载时，远程请求的 Origin 通常是 `null`，务必保留。
#
# 【本地开发 / Debug】
#   CORS_ORIGINS=null,http://localhost:328,http://127.0.0.1:328,http://localhost:5173,http://127.0.0.1:5173
#   真机/局域网访问 Vite 时，还需追加实际前端来源，例如：
#   CORS_ORIGINS=null,http://localhost:5173,http://127.0.0.1:5173,http://your-mac.local:5173,http://192.168.x.x:5173
#
# 【本地 / 局域网 / 可选远程部署】
#   1. 本地开发建议直接使用本机或局域网地址，
#      前端构建时通过 VITE_MOBILE_API_BASE_URL 写入该地址。
#   2. 配置 CORS_ORIGINS 为实际前端来源（示例）：
#      CORS_ORIGINS=null,http://localhost:328,http://127.0.0.1:328,http://your-mac.local:5173
#   3. 若后端前方有 Nginx 反向代理，Nginx 应设置：
#      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#      proxy_set_header X-Forwarded-Proto $scheme;
#      proxy_set_header Host $host;
#   4. 如需远程部署，再按需扩展为公网固定域名方案。
CORS_ORIGINS=null,http://localhost:328,http://127.0.0.1:328,http://localhost:5173,http://127.0.0.1:5173

# ========== 视频推荐（站内候选上限、站外默认与超时） ==========
# RECOMMENDATION_CONTRACT_VERSION=2
# v2 默认不返回 seed_video_title；设为 1 可兼容旧客户端
# RECOMMENDATION_MAX_CANDIDATES_SCAN=400
# RECOMMENDATION_INCLUDE_EXTERNAL_DEFAULT=false
# RECOMMENDATION_AUTO_IMPORT_EXTERNAL=true
# RECOMMENDATION_AUTO_IMPORT_MAX_ITEMS=2
# RECOMMENDATION_SIMILARITY_MIN_SCORE=0.55
# RECOMMENDATION_RETURN_MIN_ITEMS=6
# RECOMMENDATION_RETURN_MAX_ITEMS=8
# RECOMMENDATION_EXCLUDED_TITLE_KEYWORDS=排列组合插空法详解
# RECOMMENDATION_EXTERNAL_TIMEOUT_SECONDS=8
# RECOMMENDATION_EXTERNAL_FETCH_PARALLEL=true
# RECOMMENDATION_EXTERNAL_FETCH_RETRIES=1
# RECOMMENDATION_OPS_EVENT_BUFFER_SIZE=5000

# ========== 集中式遥测告警阈值（含 Vinci） ==========
ANALYTICS_LOG_LEVEL=INFO
ANALYTICS_ALERT_MAX_FAILURE_RATE=0.15
ANALYTICS_ALERT_MAX_TIMEOUT_RATE=0.10
ANALYTICS_ALERT_LATENCY_TIMEOUT_MS=30000
ANALYTICS_ALERT_MAX_P95_LATENCY_MS=12000
ANALYTICS_ALERT_DRIFT_REL_THRESHOLD=0.10
ANALYTICS_ALERT_MIN_INTERVAL_SEC=60
ANALYTICS_TRACE_ID_PLACEHOLDER=unset

# ========== 语义搜索（默认推荐本地字幕语义搜索） ==========
SEARCH_ENABLED=false
SEARCH_BACKEND=local
SEARCH_LOCAL_MODEL=hashing-char-ngrams-zh
SEARCH_GEMINI_API_KEY=
SEARCH_CHROMA_DB_DIR=./data/chroma
SEARCH_ADAPTIVE_CHUNKING=true
SEARCH_CHUNK_DURATION=30
SEARCH_CHUNK_OVERLAP=5
SEARCH_SIMILARITY_THRESHOLD=0.5
SEARCH_TAG_MATCH_ENABLED=false
SEARCH_TAG_MATCH_WEIGHT=0.18
SEARCH_PREPROCESS=true
SEARCH_PREPROCESS_RESOLUTION=480
SEARCH_PREPROCESS_FPS=5
SEARCH_AUTO_INDEX_NEW_VIDEOS=true

# ========== 存储维护（防止临时/残留文件长期占用磁盘） ==========
# 启用后：启动时先执行一次清理，然后按 interval 周期巡检清理
STORAGE_MAINTENANCE_ENABLED=true
STORAGE_MAINTENANCE_INTERVAL_SECONDS=21600
STORAGE_MAINTENANCE_FILE_MAX_AGE_HOURS=24
STORAGE_MAINTENANCE_CHUNK_DIR_MAX_AGE_HOURS=12
STORAGE_MAINTENANCE_CHROMA_BACKUP_MAX_AGE_HOURS=168
STORAGE_MAINTENANCE_KEEP_RECENT_CHROMA_BACKUPS=1

# ========== Redis 配置 (可选) ==========
REDIS_URL=redis://localhost:6379/0
