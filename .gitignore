# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment files (contain secrets)
.env                # 本地运行时 cp .env.local .env
.env.local          # 本地开发覆盖（gitignore）
.env.*.local        # 本地环境覆盖
.env.cloud          # 云端部署覆盖模板（gitignore）

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Uploads
uploads/
temp/

# Cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
data/chroma/

# pre-commit
.venv-hook/

# secrets baseline (regenerate per project)
.secrets.baseline

# Distribution
dist/
build/
*.egg-info/
models/whisper/

# Local commit log
COMMIT_LOG.md

# Local change log
CHANGELOG.md
